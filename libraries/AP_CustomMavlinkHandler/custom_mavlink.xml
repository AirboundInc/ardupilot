  </enums>
  <messages>
    <!-- custom messages START -->
    <message id="15222" name="AIRBOUND_PARAMETER_GETSET">
      <description>Custom Airbound Parameter GET SET API for setting or getting a simple parameter.</description>
      <field type="uint8_t" name="target_system">system id of the target</field>
      <field type="uint8_t" name="target_component">component ID of the target</field>
      <field type="uint8_t" name="param_id" enum="AIRBOUND_PARAMETER_PARAM_ID">Identifier for the custom parameter.</field>
      <field type="uint8_t" name="action_type" enum="AIRBOUND_PARAMETER_ACTION_TYPE">Action to perform (GET or SET).</field>
      <field type="char[37]" name="data_value">Value to set (ignored for GET action).</field>
    </message>
    <message id="15223" name="AIRBOUND_PARAMETER_STATUS">
      <description>Status and value feedback for a custom Airbound parameter.</description>
      <field name="param_id" type="uint8_t">Identifier for the custom parameter from the request.</field>
      <field name="current_value" type="char[37]">The current value of the parameter.</field>
      <field name="result" type="uint8_t" enum="AIRBOUND_PARAMETER_RESULT">Result of the operation.</field>
    </message>
    <message id="15224" name="AIRBOUND_FLIGHT_INFORMATION">
      <description>Flight timing information with UTC timestamps for arming, takeoff, landing, and disarming events.</description>
      <field type="uint32_t" name="time_boot_ms" units="ms">Timestamp (time since system boot).</field>
      <field type="uint64_t" name="arming_time_utc" units="us">UTC timestamp of last arming event, retained after landing and disarm.</field>
      <field type="uint64_t" name="takeoff_time_utc" units="us">UTC timestamp of last takeoff.</field>
      <field type="uint64_t" name="landing_time_utc" units="us">UTC timestamp of last landing. Only set by the landing detector during auto-mission VTOL landings.</field>
      <field type="uint64_t" name="disarming_time_utc" units="us">UTC timestamp of last disarming event.</field>
      <field type="uint32_t" name="flight_time_ms" units="ms">Elapsed flight time since takeoff.</field>
    </message>
    <!-- custom messages END -->
  </messages>
</mavlink>
